        "一键安装Windows证书.ps1",
        "*.sh",
        "README_Linux.md"
      ]
    },
    {
      "source": "v5_server/data",
      "target": "data",
      "recursive": false,
      "patterns": [
        "*.json",
        "*.yaml",
        "*.yml",
        "*.toml",
        "*.ini",
        "*.csv",
        "*.sql"
