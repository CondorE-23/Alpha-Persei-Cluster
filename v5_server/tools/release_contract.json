      "patterns": [
        "mail_templates.json"
      ]
    },
    {
      "source": "v5_server/static_web",
      "target": "static_web",
      "recursive": true,
      "patterns": [
        "*"
      ]
    },
    {
      "source": "v5_server/static_resources",
      "target": "static_resources",
      "recursive": true,
      "patterns": [
        "*"
      ]
    },
